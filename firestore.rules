rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write, create, delete: if true;
      
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // QUIZ ATTEMPTS COLLECTION
    match /quiz_attempts/{attemptId} {
      allow read, write, create, delete: if true;
    }
  }
}
