rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // ADMIN UID — Replace with your actual admin user UID from Firebase Console
    // To find it: Firebase Console → Authentication → Users → Copy UID
    // ==========================================
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_ADMIN_UID';
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read their OWN profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Any authenticated user can create/update their OWN profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Admin can read ALL user profiles
      allow read: if isAdmin();
      
      // Admin can delete any user profile
      allow delete: if isAdmin();

      // Subcollections under user (ai_chats, favorites)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    // ==========================================
    // QUIZ ATTEMPTS COLLECTION
    // ==========================================
    match /quiz_attempts/{attemptId} {
      // Any authenticated user can create a quiz attempt
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Any authenticated user can read their OWN attempts
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Admin can read ALL quiz attempts
      allow read: if isAdmin();
      
      // Admin can delete any quiz attempt
      allow delete: if isAdmin();
      
      // No one can update existing attempts (immutable records)
      allow update: if false;
    }
  }
}
